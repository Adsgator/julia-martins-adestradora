---
import { Image } from "astro:assets";

interface Props {
  name: string;
  rating: number;
  text: string;
  image?: ImageMetadata;
  initials?: string;
  avatarClass?: string;
  date?: string;
}

const { name, rating, text, image, initials, avatarClass = "avatar-secondary" } = Astro.props;
const stars = Array(rating).fill("★").join("");
---

<div class="premium-panel surface-card-light card-hover flex h-full min-h-[260px] md:min-h-[300px] flex-col gap-5 p-5 sm:p-6 lg:p-7" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.76);">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      {image ? (
        <Image
          src={image}
          alt={name}
          width={48}
          height={48}
          class="h-12 w-12 flex-shrink-0 rounded-full object-cover"
        />
      ) : (
        <div class:list={[avatarClass, "flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full"]}>
          <span class="font-sans text-lg font-bold text-white">{initials}</span>
        </div>
      )}
      <div>
        <p class="font-sans text-sm font-semibold text-text-main">{name}</p>
        <div class="text-base tracking-[0.2em] text-secondary" aria-label={`${rating} estrelas`}>{stars}</div>
      </div>
    </div>
  </div>

  <p class="font-sans text-sm leading-relaxed text-text-soft">"{text}"</p>
</div>
