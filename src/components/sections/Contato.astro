---
// Contato — bloco 14 do roteiro da cliente.
//
// A cliente pediu explicitamente para NÃO terminar com "transforme o
// comportamento do seu cão hoje" (linguagem do site antigo). A copy abaixo
// é a que ela escreveu. As três modalidades vêm do roteiro.
//
// Substitui o antigo CtaFinal.astro.

import { Icon } from "astro-icon/components";

const WA_NUMBER = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const WA_MESSAGE = "Olá! Quero conversar sobre o meu cão.";
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_MESSAGE)}`;

const modalidades = [
  {
    icone: "lucide:map-pin",
    titulo: "Atendimento presencial",
    detalhe: "Itajubá • Piranguçu",
  },
  {
    icone: "lucide:video",
    titulo: "Treinamento em grupo e online",
    detalhe: "Brasil",
  },
  {
    icone: "lucide:briefcase",
    titulo: "Profissionais",
    detalhe: "Mentorias individuais e para espaços caninos",
  },
];
---

<section id="contato" class="section-py bg-surface">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div>
        <span class="label-tag mb-6 inline-block" data-animate>Contato</span>

        <h2
          class="font-serif text-display-xl font-bold text-text-main [text-wrap:balance]"
          data-animate
        >
          Vamos melhorar a
          <span class="text-primary">convivência entre vocês?</span>
        </h2>

        <p class="mt-7 max-w-prose font-sans text-body-lg text-text-soft" data-animate>
          Conte um pouco sobre você, seu cão e o que vocês precisam. A partir dessas informações,
          podemos entender qual modalidade de atendimento faz mais sentido.
        </p>

        <a
          href={WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary-gold mt-9 inline-flex"
          data-tracking="whatsapp-contato"
          data-section="contato"
          data-animate
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5 flex-shrink-0"
            viewBox="0 0 448 512"
            fill="currentColor"
          >
            <path
              d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
            />
          </svg>
          Quero conversar sobre meu cão
        </a>

        <p class="mt-5 font-sans text-body-sm text-text-muted" data-animate>
          Atendimento de segunda a sexta, das 8h às 18h, conforme disponibilidade de agenda.
        </p>
      </div>

      <ul class="space-y-0" data-animate-group>
        {
          modalidades.map((modalidade) => (
            <li
              class="flex items-start gap-5 border-b border-border py-7 first:border-t"
              data-animate-item
            >
              <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-primary/8 text-primary">
                <Icon name={modalidade.icone} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-serif text-body-lg font-semibold text-text-main">
                  {modalidade.titulo}
                </h3>
                <p class="mt-1 font-sans text-body-base text-text-soft">{modalidade.detalhe}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
