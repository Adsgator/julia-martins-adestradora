---
// FAQ — as 9 objeções reais levantadas no briefing.
// A mecânica do acordeão (animação de altura, aria-expanded, respeito a
// prefers-reduced-motion) vem da biblioteca e não deve ser reescrita.

import { Icon } from "astro-icon/components";

const faqs = [
  {
    question: "Você atende quais cidades?",
    answer:
      "Realizo atendimentos presenciais em Itajubá e Piranguçu, além de treinamentos em grupo em São José dos Campos e Poços de Caldas. Também ofereço acompanhamento online para quem está longe.",
  },
  {
    question: "O treinamento é feito na minha casa?",
    answer:
      "A modalidade de atendimento depende da necessidade do cão e do objetivo do treinamento. Durante a avaliação definimos juntos o formato mais adequado.",
  },
  {
    question: "Você atende filhotes?",
    answer:
      "Sim. O trabalho com filhotes constrói uma boa base de educação, manejo, rotina, socialização e comunicação desde os primeiros meses, prevenindo problemas de comportamento no futuro.",
  },
  {
    question: "Você trabalha com problemas comportamentais?",
    answer:
      "Sim. Casos comportamentais são avaliados individualmente para entender as causas antes de definir qualquer estratégia. Medo, reatividade, ansiedade, destruição e dificuldade de ficar sozinho são alguns dos casos atendidos.",
  },
  {
    question: "Preciso ter experiência com cães?",
    answer:
      "Não. O treinamento também ensina você a conduzir e se comunicar melhor com o seu cão. Você faz parte ativa do processo, e é justamente isso que faz o resultado durar.",
  },
  {
    question: "Você atende online?",
    answer:
      "Sim. O acompanhamento online é indicado para famílias que conseguem aplicar o treinamento na rotina e desejam orientação profissional à distância.",
  },
  {
    question: "Como funciona o Canicross?",
    answer:
      "O trabalho começa com uma introdução ao esporte, comunicação, condução, equipamentos e evolução gradual. É pensado para iniciantes que querem descobrir o esporte ao lado do cão.",
  },
  {
    question: "Você oferece treinamento em grupo?",
    answer: "Sim. Atualmente existem grupos conforme formação das turmas.",
  },
  {
    question: "Você oferece mentoria profissional?",
    answer:
      "Sim. A mentoria é voltada para profissionais, pessoas que estão começando na área e espaços como creches e daycares que querem estruturar melhor seus processos e sua rotina.",
  },
];
---

<section id="faq" class="section-py bg-background">
  <div class="container-wide max-w-5xl">
    <div class="mb-10 flex flex-col items-center" data-animate>
      <span class="label-tag justify-center">FAQ</span>
      <h2
        class="mt-4 text-center font-serif text-display-xl font-bold text-text-main [text-wrap:balance]"
      >
        Perguntas frequentes
      </h2>
      <p class="mx-auto mt-4 max-w-prose text-center font-sans text-body-lg text-text-soft">
        As dúvidas que mais aparecem antes do primeiro contato.
      </p>
    </div>

    <div class="space-y-3.5" data-animate>
      {
        faqs.map((faq) => (
          <details class="faq-item group premium-panel surface-card-light overflow-hidden">
            <summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-4 p-4 sm:p-5 lg:px-6">
              <span class="pr-4 font-serif text-body-lg font-semibold text-primary">
                {faq.question}
              </span>
              <span class="faq-icon-shell" aria-hidden="true">
                <Icon name="lucide:plus" class="faq-icon h-4 w-4 flex-shrink-0 text-secondary" />
              </span>
            </summary>
            <div class="faq-answer" data-faq-content>
              <div class="px-4 pb-4 sm:px-5 sm:pb-5 lg:px-6">
                <p class="font-sans text-body-base text-text-soft">{faq.answer}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item {
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-secondary) 24%, var(--color-border));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      0 18px 42px rgba(24, 37, 24, 0.1);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon-shell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-secondary) 10%, transparent);
    transition:
      background-color 260ms ease,
      transform 260ms ease;
  }

  .faq-icon {
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center;
  }

  .faq-item[open] .faq-icon-shell {
    background: color-mix(in srgb, var(--color-secondary) 18%, transparent);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    height: 0;
    opacity: 0;
    overflow: hidden;
    will-change: height, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon-shell,
    .faq-icon,
    .faq-answer {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var details = Array.prototype.slice.call(document.querySelectorAll("#faq details"));

    function getSummary(detail) {
      return detail.querySelector(".faq-summary");
    }

    function getContent(detail) {
      return detail.querySelector("[data-faq-content]");
    }

    function syncExpandedState(detail, expanded) {
      var summary = getSummary(detail);
      if (summary) {
        summary.setAttribute("aria-expanded", expanded ? "true" : "false");
      }
    }

    function stopAnimation(content) {
      if (content._faqAnimationFrame) {
        cancelAnimationFrame(content._faqAnimationFrame);
        content._faqAnimationFrame = 0;
      }

      content.removeEventListener("transitionend", content._faqTransitionEnd);
      content._faqTransitionEnd = null;
      content.style.transition = "none";
    }

    function animateItem(detail, shouldOpen) {
      var content = getContent(detail);
      if (!content) return;

      stopAnimation(content);

      if (reduceMotion) {
        detail.open = shouldOpen;
        content.style.height = shouldOpen ? "auto" : "0px";
        content.style.opacity = shouldOpen ? "1" : "0";
        content.style.overflow = shouldOpen ? "visible" : "hidden";
        syncExpandedState(detail, shouldOpen);
        return;
      }

      var startHeight = content.offsetHeight;

      if (shouldOpen) {
        detail.open = true;
        syncExpandedState(detail, true);
      }

      var endHeight = shouldOpen ? content.scrollHeight : 0;

      content.style.overflow = "hidden";
      content.style.height = startHeight + "px";
      content.style.opacity = shouldOpen ? "0" : "1";

      content._faqAnimationFrame = requestAnimationFrame(function () {
        content.style.transition =
          "height 340ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease";
        content.style.height = endHeight + "px";
        content.style.opacity = shouldOpen ? "1" : "0";
      });

      content._faqTransitionEnd = function (event) {
        if (event.propertyName !== "height") return;

        content.removeEventListener("transitionend", content._faqTransitionEnd);
        content._faqTransitionEnd = null;
        content.style.transition = "none";
        content.style.height = shouldOpen ? "auto" : "0px";
        content.style.overflow = shouldOpen ? "visible" : "hidden";

        if (!shouldOpen) {
          detail.open = false;
          syncExpandedState(detail, false);
        }
      };

      content.addEventListener("transitionend", content._faqTransitionEnd);
    }

    details.forEach(function (detail) {
      var content = getContent(detail);
      var summary = getSummary(detail);

      if (!content || !summary || detail.dataset.faqInit === "true") return;

      detail.dataset.faqInit = "true";
      content.style.height = detail.open ? "auto" : "0px";
      content.style.opacity = detail.open ? "1" : "0";
      content.style.overflow = detail.open ? "visible" : "hidden";
      syncExpandedState(detail, detail.open);

      summary.addEventListener("click", function (event) {
        event.preventDefault();

        var willOpen = !detail.open;

        details.forEach(function (other) {
          if (other !== detail && other.open) {
            animateItem(other, false);
          }
        });

        animateItem(detail, willOpen);
      });
    });
  })();
</script>
