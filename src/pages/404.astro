---
import BaseLayout from "../layouts/BaseLayout.astro";

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const waMessage =
  import.meta.env.PUBLIC_WA_MESSAGE || "Olá! Vi seu site e gostaria de mais informações.";
const WA_LINK = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
---

<BaseLayout title="Página não encontrada | Julia Martins Adestradora" noindex>
  <main id="main-content" class="bg-background">
    <section class="legal-shell min-h-[70vh]">
      <div class="legal-card relative overflow-hidden text-center">
        <p class="page-watermark" aria-hidden="true">
          404
        </p>

        <div class="relative z-10 mx-auto max-w-xl">
          <p class="legal-subtitle">Página não encontrada</p>
          <h1 class="legal-title mt-4">Essa página não foi encontrada</h1>
          <p class="legal-copy">
            A página que você buscou não existe mais ou foi movida. Se preferir,
            você pode voltar para o início ou falar com a Júlia pelo WhatsApp.
          </p>

          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/" class="btn-primary" id="btn-404-home" data-tracking="click-404-home">
              Voltar ao início
            </a>
            <a
              href={WA_LINK}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
              id="btn-404-whatsapp"
              data-tracking="click-404-whatsapp"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
