---
// Página de links (bio-link do Instagram/TikTok).
//
// Irmã da `links.astro` da Natu (`../NATU-ESPACO-CANINO`): mesma estrutura
// — banner, avatar sobreposto, perfil, redes, lista de botões — vestida com
// a identidade da Júlia. O que muda é o que já diferencia os dois projetos:
// verde #1e432c, caramelo no CTA, creme mais claro e botões em pílula.
//
// **Standalone de propósito.** Não usa o BaseLayout nem o global.css: é
// aberta do Instagram, no 4G, para quatro botões. Carregar Tailwind, GSAP,
// Lenis e Swiper aqui seria desperdício. O preço é declarar o @font-face da
// Gliker e alguns valores de raio/sombra localmente, já que o `@theme` do
// global.css é `inline` e não existe em runtime.

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Poppins local, via @fontsource — os mesmos pesos que esta página usa.
// Nada de Google Fonts CDN: o projeto removeu o @import de propósito
// (três idas encadeadas de rede e o IP do visitante indo para o Google).
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";

// As cores vêm de tokens.css, que é `:root` puro e vive sem o global.css.
import "../styles/tokens.css";

// `avatar-julia.webp` é um recorte quadrado de `julia-retrato.webp` no rosto
// (440×440 a partir de 235,80 → 400×400). Existe porque num círculo de 96px
// o retrato de corpo inteiro deixa o rosto com ~16px: `object-position` não
// resolve enquadramento, só o desloca. A Natu tem o dela pelo mesmo motivo.
import avatarJulia from "../assets/images/avatar-julia.webp";
import bannerJulia from "../assets/images/hero-canicross.webp";

export const prerender = true;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://juliamartinsadestradora.com.br";
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || "GTM-TVBKMTWJ";
const waNumber = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const waMessage = import.meta.env.PUBLIC_WA_MESSAGE || "Olá! Vi o site e quero saber mais.";

// Mesmos destinos já usados no site: o perfil do Google vem do Testimonials
// e a Natu, do Footer. Não inventar URL nova para nenhum dos dois.
const GOOGLE_URL = "https://maps.app.goo.gl/3KAZTvTBmEtAhcgu7";
const NATU_URL = "https://natuespacocanino.com.br/";

const perfil = {
  nome: "Júlia Martins",
  cargo: "Adestradora · Presencial e On-line",
};

// lucide não tem o logo do TikTok — o Footer já resolve com `music-2`.
const redesSociais = [
  {
    nome: "Instagram",
    icone: "lucide:instagram",
    href: "https://www.instagram.com/juliamartinsadestradora/",
    ariaLabel: "Instagram da Júlia Martins Adestradora",
    tracking: "click-instagram-links",
  },
  {
    nome: "TikTok",
    icone: "lucide:music-2",
    href: "https://www.tiktok.com/@juliamartinsadestradora",
    ariaLabel: "TikTok da Júlia Martins Adestradora",
    tracking: "click-tiktok-links",
  },
];

// `variant` desenha a hierarquia: verde no site dela, caramelo no WhatsApp
// (o CTA de conversão, como no header), neutro no resto.
const links = [
  {
    id: "btn-links-site-julia",
    label: "Acessar site Julia",
    href: siteUrl,
    icone: "lucide:globe",
    tracking: "click-site-julia-links",
    variant: "primary",
    newTab: false,
  },
  {
    id: "btn-links-site-natu",
    label: "Acessar site Natu",
    href: NATU_URL,
    icone: "lucide:paw-print",
    tracking: "click-site-natu-links",
    variant: "ghost",
    newTab: true,
  },
  {
    id: "btn-links-avaliacao",
    label: "Deixe sua avaliação",
    href: GOOGLE_URL,
    icone: "lucide:star",
    tracking: "click-avaliacao-links",
    variant: "ghost",
    newTab: true,
  },
  {
    id: "btn-links-wa",
    label: "Fale pelo WhatsApp",
    href: `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`,
    icone: "whatsapp",
    tracking: "click-whatsapp-links",
    variant: "gold",
    newTab: true,
  },
];

// Parcerias externas com desconto. Não são links diretos: abrem um popup
// com o cupom/código, um botão de copiar e só então o link para o site do
// parceiro — assim o visitante sabe o que fazer com o código sem precisar
// de explicação no Instagram.
const parcerias = [
  {
    id: "btn-links-biobone",
    trigger: "click-parceria-biobone",
    ctaTracking: "click-parceria-biobone-site",
    label: "Parceria Biobone",
    icone: "lucide:bone",
    partner: "Biobone",
    desc: "Mordedores biodegradáveis para cães. Use o cupom abaixo na loja oficial e garanta seu desconto.",
    couponLabel: "Cupom de desconto",
    couponCode: "NATU",
    href: "https://www.biobonebrazil.com.br?utm_campaign=NATU",
  },
  {
    id: "btn-links-formula-natural",
    trigger: "click-parceria-formula",
    ctaTracking: "click-parceria-formula-site",
    label: "Parceria Fórmula Natural",
    icone: "lucide:leaf",
    partner: "Fórmula Natural",
    desc: "Informe o código abaixo no site da Fórmula Natural e garanta seu desconto.",
    couponLabel: "Código de identificação",
    couponCode: "JULIAMARTINS",
    href: "https://fnon.com.br/indications/new",
  },
];

const currentYear = new Date().getFullYear();
const pageTitle = "Júlia Martins Adestradora | Links";
const pageDescription =
  "Adestramento, comportamento canino, canicross e mentoria em Itajubá, Piranguçu e online.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <script is:inline define:vars={{ GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":
      new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src=
      "https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,"script","dataLayer",GTM_ID);
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <!-- Exceção conhecida ao "nunca hardcode": HTML não aceita var() aqui. -->
    <meta name="theme-color" content="#1e432c" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={`${siteUrl}/links`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/links`} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Consent Mode v2, igual ao BaseLayout: as quatro chaves, não duas. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        analytics_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
      });
    </script>

    <style>
      /* Gliker mora em public/Gliker-font. Só o SemiBold: é o único peso
         que esta página usa (o nome do perfil). */
      @font-face {
        font-family: "Gliker";
        src:
          url("/Gliker-font/Gliker-SemiBold.woff2") format("woff2"),
          url("/Gliker-font/Gliker-SemiBold.woff") format("woff");
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        height: 100%;
      }

      body {
        /* Valores que no site vêm do @theme do global.css. Ele é `inline`,
           então as variáveis não existem em runtime — aqui são locais. */
        --ease-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        --sombra-card: 0 18px 50px rgba(24, 37, 24, 0.08);

        font-family: var(--t-font-sans);
        font-weight: 400;
        /* Creme forte fora do cartão, creme claro dentro: o mesmo par que
           alterna entre as seções do site. */
        background-color: var(--t-background-strong);
        color: var(--t-text-main);
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .links-page {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .hero-banner {
        position: relative;
        width: 100%;
        max-width: 430px;
        height: 220px;
        overflow: hidden;
        flex-shrink: 0;
      }

      .hero-banner__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 25%;
        display: block;
      }

      .hero-banner__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(30, 67, 44, 0.12) 0%, rgba(16, 24, 15, 0.42) 100%);
      }

      .profile-card {
        width: 100%;
        max-width: 430px;
        background-color: var(--t-background);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 20px 48px;
        flex: 1;
      }

      .avatar-wrapper {
        margin-top: -48px;
        z-index: 10;
        position: relative;
      }

      .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--t-background);
        box-shadow: 0 4px 20px rgba(24, 37, 24, 0.2);
        display: block;
        background-color: var(--t-background-strong);
      }

      .profile-info {
        margin-top: 14px;
        text-align: center;
        margin-bottom: 8px;
      }

      .profile-name {
        font-family: var(--t-font-serif);
        font-size: 2rem;
        font-weight: 600;
        color: var(--t-primary);
        letter-spacing: 0.01em;
        line-height: 1.1;
        text-wrap: balance;
      }

      .profile-role {
        /* Caramelo em texto miúdo pede o token de texto (4,57:1). O
           --t-secondary da marca mede 3,43:1 e só vale para texto grande. */
        font-size: 11px;
        font-weight: 600;
        color: var(--t-secondary-text);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-top: 6px;
      }

      .social-icons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-top: 20px;
        margin-bottom: 28px;
      }

      .social-icon-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--t-border);
        border-radius: 50%;
        color: var(--t-text-muted);
        background-color: var(--t-surface);
        text-decoration: none;
        transition:
          border-color 0.3s var(--ease-smooth),
          color 0.3s var(--ease-smooth),
          transform 0.3s var(--ease-smooth);
      }

      .social-icon-link:hover {
        border-color: var(--t-primary);
        color: var(--t-primary);
        transform: translateY(-2px);
      }

      .social-icon-link:active {
        transform: translateY(0) scale(0.96);
      }

      .social-icon-link:focus-visible {
        outline: 2px solid var(--t-primary);
        outline-offset: 2px;
      }

      .links-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .link-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px 24px;
        font-family: var(--t-font-sans);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.01em;
        text-decoration: none;
        /* Pílula, não os 8px da Natu: é o desenho dos botões da Júlia. */
        border-radius: 9999px;
        border: 1px solid transparent;
        /* Dois destes botões agora são <button> (abrem popup em vez de
           navegar). O <button> não herda cursor:pointer do <a> por
           padrão, então precisa do reset explícito. */
        cursor: pointer;
        appearance: none;
        transition:
          background-color 0.3s var(--ease-smooth),
          border-color 0.3s var(--ease-smooth),
          color 0.3s var(--ease-smooth),
          box-shadow 0.3s var(--ease-smooth),
          transform 0.3s var(--ease-smooth);
      }

      .link-btn:hover {
        transform: translateY(-2px);
      }

      .link-btn:active {
        transform: translateY(0) scale(0.98);
      }

      .link-btn:focus-visible {
        outline: 2px solid var(--t-primary);
        outline-offset: 2px;
      }

      .link-btn__icon {
        display: flex;
        flex-shrink: 0;
      }

      .link-btn.primary {
        background-color: var(--t-primary);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.1);
        box-shadow: 0 2px 14px rgba(30, 67, 44, 0.26);
      }

      .link-btn.primary:hover {
        background-color: var(--t-primary-dark);
        box-shadow: 0 6px 22px rgba(30, 67, 44, 0.34);
      }

      .link-btn.ghost {
        background-color: var(--t-surface);
        color: var(--t-primary);
        border-color: var(--t-border);
        box-shadow: 0 1px 4px rgba(24, 37, 24, 0.06);
      }

      .link-btn.ghost:hover {
        border-color: var(--t-primary);
        background-color: var(--t-background-strong);
        box-shadow: var(--sombra-card);
      }

      /* Mesmo gradiente do .btn-secondary-gold do site: caramelo com texto
         verde-escuro, que é o par de contraste já aprovado. */
      .link-btn.gold {
        color: var(--t-primary);
        border-color: var(--t-accent-gold-border);
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--t-accent-gold) 96%, white 4%),
          color-mix(in srgb, var(--t-secondary) 82%, var(--t-accent-gold) 18%)
        );
        box-shadow: 0 2px 14px rgba(181, 121, 63, 0.28);
      }

      .link-btn.gold:hover {
        border-color: var(--t-accent-gold-border-hover);
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--t-accent-gold-hover) 96%, white 4%),
          color-mix(in srgb, var(--t-secondary-hover) 82%, var(--t-accent-gold-hover) 18%)
        );
        box-shadow: 0 6px 22px rgba(181, 121, 63, 0.36);
      }

      .parcerias-label {
        width: 100%;
        margin-top: 28px;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--t-text-muted);
        text-align: center;
      }

      /* Modal de parceria: reaproveitado pelos dois botões, preenchido via
         JS a partir dos data-* do botão que o abriu. Sem transição na
         abertura de propósito — é o jeito mais simples de não recair na
         armadilha do prefers-reduced-motion que este projeto já viu
         demais (marquee, pin, arraste): sem opacity/transform inicial,
         não tem estado "preso invisível" para o Windows com animação
         desligada. */
      dialog.parceria-modal {
        /* O reset `* { margin: 0 }` do topo deste arquivo zera o
           `margin: auto` que o navegador usa para centralizar um <dialog>
           modal — sem isso ele cola no canto superior esquerdo. Precisa
           declarar de novo, explícito, em vez de confiar no padrão da UA. */
        position: fixed;
        inset: 0;
        margin: auto;
        border: none;
        border-radius: 20px;
        padding: 16px 24px 24px;
        width: min(92vw, 380px);
        max-height: min(88vh, 520px);
        background-color: var(--t-surface);
        box-shadow: 0 24px 60px rgba(16, 24, 15, 0.28);
        color: var(--t-text-main);
      }

      dialog.parceria-modal::backdrop {
        background-color: rgba(16, 24, 15, 0.55);
      }

      dialog.parceria-modal:not([open]) {
        display: none;
      }

      .parceria-modal__header {
        display: flex;
        justify-content: flex-end;
      }

      .parceria-modal__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid var(--t-border);
        background-color: var(--t-surface);
        color: var(--t-text-muted);
        cursor: pointer;
        appearance: none;
        transition:
          border-color 0.2s var(--ease-smooth),
          color 0.2s var(--ease-smooth);
      }

      .parceria-modal__close:hover {
        border-color: var(--t-primary);
        color: var(--t-primary);
      }

      .parceria-modal__eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--t-secondary-text);
        margin-bottom: 6px;
      }

      .parceria-modal__title {
        font-family: var(--t-font-serif);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--t-primary);
        line-height: 1.2;
        margin-bottom: 10px;
      }

      .parceria-modal__desc {
        font-size: 14px;
        line-height: 1.5;
        color: var(--t-text-soft);
        margin-bottom: 20px;
      }

      .parceria-modal__coupon {
        background-color: var(--t-background-strong);
        border: 1px solid var(--t-border);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 20px;
      }

      .parceria-modal__coupon-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--t-text-muted);
        margin-bottom: 8px;
      }

      .parceria-modal__coupon-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .parceria-modal__coupon-code {
        flex: 1;
        min-width: 0;
        font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--t-primary);
        background-color: var(--t-surface);
        border: 1px dashed var(--t-accent-gold-border);
        border-radius: 10px;
        padding: 8px 12px;
        overflow-x: auto;
        white-space: nowrap;
      }

      .parceria-modal__copy {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        padding: 9px 14px;
        font-family: var(--t-font-sans);
        font-size: 13px;
        font-weight: 600;
        border-radius: 9999px;
        border: 1px solid var(--t-primary);
        background-color: var(--t-primary);
        color: #ffffff;
        cursor: pointer;
        appearance: none;
        transition:
          background-color 0.2s var(--ease-smooth),
          transform 0.2s var(--ease-smooth);
      }

      .parceria-modal__copy:hover {
        background-color: var(--t-primary-dark);
      }

      .parceria-modal__copy:active {
        transform: scale(0.97);
      }

      .parceria-modal__copy-icon.icon-check {
        display: none;
      }

      .parceria-modal__copy.is-copied .icon-copy {
        display: none;
      }

      .parceria-modal__copy.is-copied .icon-check {
        display: block;
      }

      .parceria-modal__cta {
        width: 100%;
      }

      .page-footer {
        margin-top: 40px;
        font-size: 11px;
        color: var(--t-text-muted);
        text-align: center;
        line-height: 1.6;
      }

      .page-footer a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
        /* Alvo de toque (WCAG 2.5.8): 16px de linha não bastam. O padding
           cresce a área de clique e a margem negativa devolve o espaço ao
           layout, então o rodapé fica com o mesmo desenho. */
        display: inline-block;
        padding-block: 0.3rem;
        margin-block: -0.3rem;
      }

      .page-footer a:hover {
        color: var(--t-primary);
      }

      .link-item {
        opacity: 0;
        transform: translateY(20px);
      }

      @keyframes fadeUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Sem esta regra a página fica INVISÍVEL na máquina de quem tem
         "Mostrar animações" desligado no Windows — o Chrome reporta
         `reduce` e o estado inicial do fadeUp nunca sai do opacity: 0.
         É a armadilha nº 1 deste projeto. Não remover. */
      @media (prefers-reduced-motion: reduce) {
        .link-item {
          opacity: 1;
          transform: none;
          animation: none !important;
        }

        .link-btn:hover,
        .social-icon-link:hover {
          transform: none;
        }
      }
    </style>
  </head>

  <body>
    {GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <main class="links-page">
      <div class="hero-banner">
        <Image
          src={bannerJulia}
          alt="Júlia Martins correndo com dois cães em uma estrada de terra"
          class="hero-banner__img"
          width={860}
          height={525}
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-banner__overlay" aria-hidden="true"></div>
      </div>

      <div class="profile-card">
        <div class="avatar-wrapper link-item" style="animation: fadeUp 0.5s 0s ease both">
          <Image
            src={avatarJulia}
            alt="Júlia Martins"
            class="avatar"
            width={288}
            height={288}
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="profile-info link-item" style="animation: fadeUp 0.5s 0.07s ease both">
          <h1 class="profile-name">{perfil.nome}</h1>
          <p class="profile-role">{perfil.cargo}</p>
        </div>

        <nav
          class="social-icons link-item"
          style="animation: fadeUp 0.5s 0.14s ease both"
          aria-label="Redes sociais"
        >
          {redesSociais.map((rede) => (
            <a
              href={rede.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={rede.ariaLabel}
              data-tracking={rede.tracking}
              data-section="links"
              class="social-icon-link"
            >
              <Icon name={rede.icone} width={18} height={18} aria-hidden="true" />
            </a>
          ))}
        </nav>

        <div class="links-list" role="list">
          {links.map((link, i) => (
            <div
              role="listitem"
              class="link-item"
              style={`animation: fadeUp 0.5s ${0.2 + i * 0.08}s ease both`}
            >
              <a
                href={link.href}
                id={link.id}
                data-tracking={link.tracking}
                data-section="links"
                class={`link-btn ${link.variant}`}
                {...(link.newTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span class="link-btn__icon" aria-hidden="true">
                  {link.icone === "whatsapp" ? (
                    <svg
                      class="link-btn__wa"
                      width="20"
                      height="20"
                      viewBox="0 0 448 512"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                    </svg>
                  ) : (
                    <Icon name={link.icone} width={20} height={20} aria-hidden="true" />
                  )}
                </span>
                <span>{link.label}</span>
              </a>
            </div>
          ))}
        </div>

        <p
          class="parcerias-label link-item"
          style={`animation: fadeUp 0.5s ${0.2 + links.length * 0.08}s ease both`}
        >
          Parcerias com desconto
        </p>

        <div class="links-list" role="list">
          {parcerias.map((p, i) => (
            <div
              role="listitem"
              class="link-item"
              style={`animation: fadeUp 0.5s ${0.2 + (links.length + 1 + i) * 0.08}s ease both`}
            >
              <button
                type="button"
                id={p.id}
                data-tracking={p.trigger}
                data-section="links"
                data-modal-trigger="true"
                data-partner={p.partner}
                data-desc={p.desc}
                data-coupon-label={p.couponLabel}
                data-coupon-code={p.couponCode}
                data-href={p.href}
                data-cta-tracking={p.ctaTracking}
                aria-haspopup="dialog"
                class="link-btn ghost"
              >
                <span class="link-btn__icon" aria-hidden="true">
                  <Icon name={p.icone} width={20} height={20} aria-hidden="true" />
                </span>
                <span>{p.label}</span>
              </button>
            </div>
          ))}
        </div>

        <dialog id="parceria-modal" class="parceria-modal" aria-labelledby="parceria-modal-title">
          <div class="parceria-modal__header">
            <button type="button" class="parceria-modal__close" data-modal-close aria-label="Fechar">
              <Icon name="lucide:x" width={18} height={18} aria-hidden="true" />
            </button>
          </div>
          <p class="parceria-modal__eyebrow">Parceria</p>
          <h2 id="parceria-modal-title" class="parceria-modal__title" data-modal-partner></h2>
          <p class="parceria-modal__desc" data-modal-desc></p>

          <div class="parceria-modal__coupon">
            <span class="parceria-modal__coupon-label" data-modal-coupon-label></span>
            <div class="parceria-modal__coupon-row">
              <code class="parceria-modal__coupon-code" data-modal-coupon-code></code>
              <button type="button" class="parceria-modal__copy" data-modal-copy>
                <Icon
                  name="lucide:copy"
                  width={16}
                  height={16}
                  class="parceria-modal__copy-icon icon-copy"
                  aria-hidden="true"
                />
                <Icon
                  name="lucide:check"
                  width={16}
                  height={16}
                  class="parceria-modal__copy-icon icon-check"
                  aria-hidden="true"
                />
                <span data-modal-copy-text>Copiar</span>
              </button>
            </div>
          </div>

          <a
            class="link-btn primary parceria-modal__cta"
            data-modal-cta
            data-section="links"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Ir para o site</span>
            <span class="link-btn__icon" aria-hidden="true">
              <Icon name="lucide:external-link" width={18} height={18} aria-hidden="true" />
            </span>
          </a>
        </dialog>

        <footer
          class="page-footer link-item"
          style={`animation: fadeUp 0.5s ${0.2 + (links.length + 1 + parcerias.length) * 0.08}s ease both`}
        >
          <p>© {currentYear} Júlia Martins Adestradora</p>
          <p>
            <a href="/politica-de-privacidade">Política de Privacidade</a> ·
            <a href="/termos-de-uso">Termos de Uso</a>
          </p>
        </footer>
      </div>
    </main>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "view_links", page_type: "links_page" });

      document.addEventListener("click", function (e) {
        var el = e.target.closest("[data-tracking]");
        if (!el) return;
        var action = el.getAttribute("data-tracking");
        var section = el.getAttribute("data-section");
        window.dataLayer.push({
          event: "link_click",
          click_action: action,
          click_section: section || "unknown",
        });
        // Mesmo evento de conversão do resto do site.
        if (action && action.includes("whatsapp")) {
          window.dataLayer.push({
            event: "contato_wpp",
            click_action: action,
            click_section: section || "unknown",
          });
        }
      });
    </script>

    <script is:inline>
      (function () {
        var modal = document.getElementById("parceria-modal");
        if (!modal) return;

        var titleEl = modal.querySelector("[data-modal-partner]");
        var descEl = modal.querySelector("[data-modal-desc]");
        var couponLabelEl = modal.querySelector("[data-modal-coupon-label]");
        var couponCodeEl = modal.querySelector("[data-modal-coupon-code]");
        var copyBtn = modal.querySelector("[data-modal-copy]");
        var copyTextEl = modal.querySelector("[data-modal-copy-text]");
        var ctaEl = modal.querySelector("[data-modal-cta]");
        var closeBtn = modal.querySelector("[data-modal-close]");
        var copyResetTimer = null;

        document.querySelectorAll("[data-modal-trigger]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            titleEl.textContent = btn.getAttribute("data-partner") || "";
            descEl.textContent = btn.getAttribute("data-desc") || "";
            couponLabelEl.textContent = btn.getAttribute("data-coupon-label") || "";
            couponCodeEl.textContent = btn.getAttribute("data-coupon-code") || "";
            ctaEl.href = btn.getAttribute("data-href") || "#";
            ctaEl.setAttribute("data-tracking", btn.getAttribute("data-cta-tracking") || "");
            copyBtn.classList.remove("is-copied");
            copyTextEl.textContent = "Copiar";
            if (copyResetTimer) clearTimeout(copyResetTimer);
            modal.showModal();
          });
        });

        closeBtn.addEventListener("click", function () {
          modal.close();
        });

        // Clique no backdrop fecha: só o próprio <dialog> como target
        // (não um filho) indica que o clique caiu fora do cartão.
        modal.addEventListener("click", function (e) {
          if (e.target === modal) modal.close();
        });

        function fallbackCopy(text) {
          var textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          try {
            document.execCommand("copy");
          } catch (err) {}
          document.body.removeChild(textarea);
        }

        copyBtn.addEventListener("click", function () {
          var code = couponCodeEl.textContent;
          if (!code) return;

          function onCopied() {
            copyBtn.classList.add("is-copied");
            copyTextEl.textContent = "Copiado!";
            if (copyResetTimer) clearTimeout(copyResetTimer);
            copyResetTimer = setTimeout(function () {
              copyBtn.classList.remove("is-copied");
              copyTextEl.textContent = "Copiar";
            }, 2000);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard
              .writeText(code)
              .then(onCopied)
              .catch(function () {
                fallbackCopy(code);
                onCopied();
              });
          } else {
            fallbackCopy(code);
            onCopied();
          }
        });
      })();
    </script>
  </body>
</html>
