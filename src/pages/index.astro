---
// Página inicial — Julia Martins Adestradora
//
// Ordem baseada no roteiro da cliente. O bloco "Para quem é" foi fundido
// ao Manifesto (ambos tratavam da mesma ideia) e Serviços/Método/Pilares
// usam scroll-slider horizontal para não esticar a página.

import Divisoria from "../components/global/Divisoria.astro";
import About from "../components/sections/About.astro";
import Canicross from "../components/sections/Canicross.astro";
import Certificacao from "../components/sections/Certificacao.astro";
import ComoTrabalho from "../components/sections/ComoTrabalho.astro";
import Contato from "../components/sections/Contato.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/sections/Footer.astro";
import FormulaNatural from "../components/sections/FormulaNatural.astro";
import Grupo from "../components/sections/Grupo.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Manifesto from "../components/sections/Manifesto.astro";
import Marquee from "../components/sections/Marquee.astro";
import Mentoria from "../components/sections/Mentoria.astro";
import Metodo from "../components/sections/Metodo.astro";
import Services from "../components/sections/Services.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <Marquee />
    <Manifesto />
    <ComoTrabalho />
    <Services />
    <Metodo />
    <About />
    <Certificacao />
    {/* Serra só na entrada do Canicross, marcando a passagem para o único
        bloco escuro da página. Na saída não leva: a espelhada ficou pesada
        e a cliente pediu para tirar. */}
    <Divisoria para="dark" />
    <Canicross />
    <Grupo />
    <Testimonials />
    <FormulaNatural />
    <Mentoria />
    <FAQ />
    <Contato />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  // Rastreamento de cliques WhatsApp via dataLayer (GTM)
  document.addEventListener("click", function (e) {
    var el = e.target.closest("[data-tracking]");
    if (!el) return;
    var action = el.getAttribute("data-tracking");
    var section = el.getAttribute("data-section");
    if (action && action.includes("whatsapp")) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "contato_wpp",
        click_action: action,
        click_section: section || "unknown",
      });
    }
  });
</script>
